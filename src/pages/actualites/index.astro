---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Actualite from '../../components/Actualite.astro';

const actualites = (await getCollection('actualites')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base titre="Actualités" description="Les nouvelles du Golf de la Grande Romanie : offres, évènements et vie du club.">
  <div class="conteneur titre-page">
    <h1>Actualités</h1>
    <p>Offres, évènements et vie du club.</p>
  </div>

  <section class="conteneur liste">
    {
      actualites.length > 0 ? (
        <div class="liste__grille">
          {actualites.map((article) => <Actualite article={article} />)}
        </div>
      ) : (
        <p class="liste__vide">Les prochaines nouvelles du club seront publiées ici.</p>
      )
    }
  </section>
</Base>

<style>
  .liste {
    padding-bottom: var(--souffle);
  }

  .liste__grille {
    display: grid;
    gap: 3.5rem clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .liste__vide {
    text-align: center;
    color: var(--encre-2);
  }

  @media (min-width: 40rem) {
    .liste__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .liste__grille {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 5rem;
    }

    .liste__grille > :global(:nth-child(3n + 2)) {
      margin-top: 4.5rem;
    }
  }
</style>
