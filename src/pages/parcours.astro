---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CarteScore from '../components/CarteScore.astro';
import { reperes, trous, totaux, milliers } from '../data/parcours';

import depart from '../assets/photos/depart.jpg';
import aerienFairway from '../assets/photos/aerien-fairway.jpg';

const somme = (liste: typeof trous, cle: 'par' | 'blanc' | 'jaune' | 'bleu' | 'rouge') =>
  liste.reduce((t, trou) => t + trou[cle], 0);
const aller = trous.slice(0, 9);
const retour = trous.slice(9);
const colonnes = ['blanc', 'jaune', 'bleu', 'rouge'] as const;

const greenFees = [
  ['9 trous, semaine', 50, 38, 35, 31, 22],
  ['9 trous, week-end et jours fériés', 58, 44, 41, 33, 27],
  ['18 trous, semaine', 66, 50, 46, 40, 29],
  ['18 trous, week-end et jours fériés', 77, 58, 54, 47, 34],
  ['Pitch and putt, 9 trous', 13, 10, 9, 6, 6],
] as const;

const publics = ['Adulte', 'Carte Indigo', 'Carte Platine', 'Étudiant, jusqu’à 25 ans', 'Moins de 18 ans'];

const carnets = [
  ['9 trous, semaine', 450],
  ['9 trous, week-end et jours fériés', 520],
  ['18 trous, semaine', 595],
  ['18 trous, sept jours sur sept', 695],
] as const;
---

<Base
  titre="Le parcours"
  description="Le parcours du Golf de la Grande Romanie : un links de 18 trous, par 72, 6 145 mètres des repères blancs. Carte de score trou par trou et tarifs des green-fees."
>
  <div class="conteneur titre-page">
    <h1>Le parcours</h1>
    <p>Dix-huit trous dessinés à la manière des links écossais, sur la craie de Champagne. Par 72.</p>
  </div>

  <section class="conteneur duo recit">
    <figure class="duo__image cadre cadre--paysage recit__photo">
      <Image src={depart} alt="Un départ du parcours, entre deux rideaux d’arbres, sous un ciel dégagé" widths={[700]} loading="eager" />
    </figure>
    <div class="duo__texte texte">
      <h2>Technique, venté, dépaysant</h2>
      <p>
        Trompe-l’œil, greens surélevés, larges fairways et multitude de bunkers&nbsp;: le parcours séduit par sa
        technicité et par le dépaysement qu’il offre. La jouabilité de ce links reste un vrai défi golfique.
      </p>
      <p class="attenue">
        Son sous-sol calcaire le rend praticable toute l’année, et il demeure accessible à tous les niveaux.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur conseil">
      <blockquote>
        <p>
          Si le vent s’invite à votre partie, ne vous égarez pas trop en dehors des fairways. Les greens réclameront
          eux aussi toute votre vigilance.
        </p>
      </blockquote>
      <figure class="cadre cadre--portrait cadre--devoile">
        <Image src={aerienFairway} alt="Vue aérienne d’un fairway vallonné bordé de bunkers" widths={[439]} />
      </figure>
    </div>
  </section>

  <section class="section sur-vert" id="carte" aria-label="Carte de score">
    <div class="conteneur">
      <CarteScore titre="La carte de score" />

      <div class="tableau-defile carte-complete" data-carte-tableau data-repere="blanc" tabindex="0" role="region" aria-label="Carte de score complète">
        <table class="tableau">
          <caption class="hors-ecran">Distances en mètres pour chaque trou, selon les repères de départ</caption>
          <thead>
            <tr>
              <th scope="col">Trou</th>
              <th scope="col">Par</th>
              {reperes.map((r) => <th scope="col" data-col={r.id}><span class="pastille" style={`--c:${r.couleur}`}></span>{r.nom}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              aller.map((t) => (
                <tr>
                  <th scope="row">{t.n}</th>
                  <td>{t.par}</td>
                  {colonnes.map((c) => <td data-col={c}>{t[c]}</td>)}
                </tr>
              ))
            }
            <tr class="sous-total">
              <th scope="row">Aller</th>
              <td>{somme(aller, 'par')}</td>
              {colonnes.map((c) => <td data-col={c}>{milliers(somme(aller, c))}</td>)}
            </tr>
            {
              retour.map((t) => (
                <tr>
                  <th scope="row">{t.n}</th>
                  <td>{t.par}</td>
                  {colonnes.map((c) => <td data-col={c}>{t[c]}</td>)}
                </tr>
              ))
            }
            <tr class="sous-total">
              <th scope="row">Retour</th>
              <td>{somme(retour, 'par')}</td>
              {colonnes.map((c) => <td data-col={c}>{milliers(somme(retour, c))}</td>)}
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              <td>{totaux.par}</td>
              {colonnes.map((c) => <td data-col={c}>{milliers(totaux[c])}</td>)}
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="green-fees">
    <div class="conteneur tarifs">
      <div class="texte">
        <h2>Green-fees</h2>
        <p class="attenue">
          Tarifs au 1<sup>er</sup> janvier 2026, en euros par personne. Chariots et voiturettes se louent à l’accueil.
        </p>
      </div>

      <div class="tarifs__tableaux">
        <div class="tableau-defile tarifs__green-fees">
          <table class="tableau">
            <caption class="hors-ecran">Tarifs des green-fees</caption>
            <thead>
              <tr>
                <th scope="col"><span class="hors-ecran">Formule</span></th>
                {publics.map((public_) => <th scope="col">{public_}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                greenFees.map(([formule, ...prix]) => (
                  <tr>
                    <th scope="row">{formule}</th>
                    {prix.map((p, i) => <td data-label={publics[i]}>{p}&nbsp;€</td>)}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="tarifs__paire">
          <table class="tableau">
            <caption>Carnets de dix green-fees</caption>
            <tbody>
              {
                carnets.map(([formule, prix]) => (
                  <tr>
                    <th scope="row">{formule}</th>
                    <td>{prix}&nbsp;€</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <table class="tableau">
            <caption>Chariots et voiturettes</caption>
            <thead>
              <tr>
                <th scope="col"><span class="hors-ecran">Location</span></th>
                <th scope="col">9 trous</th>
                <th scope="col">18 trous</th>
              </tr>
            </thead>
            <tbody>
              <tr><th scope="row">Voiturette, membre</th><td>25&nbsp;€</td><td>34&nbsp;€</td></tr>
              <tr><th scope="row">Voiturette, non-membre</th><td>32&nbsp;€</td><td>40&nbsp;€</td></tr>
              <tr><th scope="row">Chariot</th><td>8&nbsp;€</td><td>8&nbsp;€</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .recit {
    padding-bottom: 0;
  }

  @media (min-width: 56rem) {
    .recit > .duo__image {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .recit > .duo__texte {
      grid-column: 9 / span 4;
      grid-row: 1;
    }
  }

  /* ---------- Le conseil du club ---------- */

  .conseil {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .conseil blockquote {
    margin: 0;
  }

  .conseil blockquote p {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1.16;
    letter-spacing: -0.012em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .conseil figure {
    max-width: 22rem;
  }

  @media (min-width: 56rem) {
    .conseil {
      grid-template-columns: 7fr 3fr;
      gap: clamp(3rem, 8vw, 8rem);
    }

    .conseil figure {
      justify-self: end;
      width: 100%;
    }
  }

  /* ---------- Carte complète, sur fond vert ---------- */

  .carte-complete {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .carte-complete .tableau {
    min-width: 30rem;
  }

  .carte-complete th,
  .carte-complete td {
    border-bottom-color: var(--filet-vert);
    padding-block: 0.7rem;
    transition:
      color 0.5s var(--sortie),
      background-color 0.5s var(--sortie);
  }

  .carte-complete thead th {
    color: var(--sur-vert-2);
    border-bottom-color: var(--sur-vert);
  }

  .carte-complete tbody th {
    font-family: var(--serif);
    font-size: 1.125rem;
  }

  .carte-complete td {
    color: var(--sur-vert-2);
  }

  .carte-complete .sous-total th,
  .carte-complete .sous-total td {
    border-bottom-color: var(--sur-vert);
    font-weight: 600;
    font-family: var(--sans);
    font-size: inherit;
  }

  .carte-complete tfoot th,
  .carte-complete tfoot td {
    border-top: 0;
    padding-top: 1.1rem;
    font-size: 1.0625rem;
  }

  .pastille {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--c);
  }

  /* La colonne des repères choisis ressort. */
  .carte-complete[data-repere='blanc'] [data-col='blanc'],
  .carte-complete[data-repere='jaune'] [data-col='jaune'],
  .carte-complete[data-repere='bleu'] [data-col='bleu'],
  .carte-complete[data-repere='rouge'] [data-col='rouge'] {
    color: var(--sur-vert);
    background: rgb(244 247 242 / 0.08);
    font-weight: 600;
  }

  .carte-complete [data-col] {
    padding-inline: 1rem;
  }

  /* Sur téléphone, seule la colonne des repères choisis reste : rien n'est hors écran. */
  @media (max-width: 39.99rem) {
    .carte-complete .tableau {
      min-width: 0;
    }

    .carte-complete [data-col] {
      display: none;
    }

    .carte-complete[data-repere='blanc'] [data-col='blanc'],
    .carte-complete[data-repere='jaune'] [data-col='jaune'],
    .carte-complete[data-repere='bleu'] [data-col='bleu'],
    .carte-complete[data-repere='rouge'] [data-col='rouge'] {
      display: table-cell;
      background: none;
    }
  }

  /* ---------- Tarifs ---------- */

  .tarifs {
    display: grid;
    gap: 3rem;
  }

  .tarifs__tableaux {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
    min-width: 0;
  }

  @media (min-width: 40rem) {
    .tarifs__tableaux .tableau-defile .tableau {
      min-width: 40rem;
    }
  }

  .tarifs__tableaux .tableau-defile thead th {
    max-width: 7rem;
  }

  /* Sur téléphone, chaque formule devient un bloc : libellé à gauche, prix à droite. */
  @media (max-width: 39.99rem) {
    .tarifs__green-fees .tableau {
      min-width: 0;
    }

    .tarifs__green-fees thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .tarifs__green-fees tbody tr {
      display: block;
      padding-block: 1.5rem;
      border-bottom: 1px solid var(--filet);
    }

    .tarifs__green-fees tbody tr:first-child {
      border-top: 1px solid var(--filet-fort);
    }

    .tarifs__green-fees tbody th {
      display: block;
      padding: 0 0 0.6rem;
      border: 0;
      font-family: var(--serif);
      font-size: 1.375rem;
      line-height: 1.15;
      white-space: normal;
    }

    .tarifs__green-fees tbody td {
      display: flex;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 0.3rem 0;
      border: 0;
      font-weight: 500;
    }

    .tarifs__green-fees tbody td::before {
      content: attr(data-label);
      font-weight: 400;
      color: var(--encre-2);
      white-space: normal;
      text-align: left;
    }
  }

  .tarifs__paire {
    display: grid;
    gap: 3rem clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  @media (min-width: 44rem) {
    .tarifs__paire {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 72rem) {
    .tarifs {
      grid-template-columns: 3fr 8fr;
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .tarifs .texte {
      position: sticky;
      top: calc(var(--entete) + 2.5rem);
    }
  }
</style>
