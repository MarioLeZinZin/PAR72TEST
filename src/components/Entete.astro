---
import { Image } from 'astro:assets';
import blason from '../assets/blason.png';
import { site, rubriques } from '../data/site';
import Fleche from './Fleche.astro';

const chemin = Astro.url.pathname;
const active = (href: string) => chemin === href || chemin.startsWith(href + '/');
---

<header class="entete" data-entete>
  <div class="entete__barre">
    <nav class="entete__rubriques" aria-label="Rubriques">
      {
        rubriques.map((r) => (
          <a href={r.href} aria-current={active(r.href) ? 'page' : undefined}>
            {r.titre}
          </a>
        ))
      }
    </nav>

    <a class="entete__marque" href="/" aria-label={`${site.nom}, accueil`}>
      <Image src={blason} alt="" width={64} densities={[1, 2, 3]} loading="eager" />
      <span>{site.nom}</span>
    </a>

    <div class="entete__actions">
      <a class="entete__tel" href={site.telephoneLien}>{site.telephone}</a>
      <a class="bouton entete__reserver" href={site.reservation} target="_blank" rel="noopener">
        Réserver un départ
        <Fleche sortante />
      </a>
      <button class="entete__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-bouton>
        <span class="entete__menu-traits" aria-hidden="true"></span>
        <span data-menu-libelle>Menu</span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="menu__liens" aria-label="Menu">
      {
        rubriques.map((r) => (
          <a href={r.href} aria-current={active(r.href) ? 'page' : undefined}>
            {r.titre}
          </a>
        ))
      }
      <a href={site.reservation} target="_blank" rel="noopener" class="menu__reserver">
        Réserver un départ
        <Fleche sortante />
      </a>
    </nav>
    <p class="menu__pied">
      <a href={site.telephoneLien}>{site.telephone}</a>
      <span>{site.adresse.join(', ')}</span>
    </p>
  </div>
</header>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--sortie);
  }

  /* Le voile est porté par un pseudo-élément : un filtre posé sur l'en-tête lui-même
     emprisonnerait le menu plein écran (position fixe) dans la hauteur de la barre. */
  .entete::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(251 253 252 / 0.94);
  }

  @supports (backdrop-filter: blur(12px)) {
    .entete::before {
      background: rgb(251 253 252 / 0.82);
      backdrop-filter: blur(14px) saturate(1.2);
    }
  }

  :global(html.a-defile) .entete {
    border-bottom-color: var(--filet);
  }

  .entete__barre {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: var(--entete);
    padding-inline: var(--marge);
  }

  .entete__rubriques {
    display: none;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
    font-size: 0.9375rem;
  }

  .entete__rubriques a {
    position: relative;
    padding-block: 0.6rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .entete__rubriques a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.5s var(--sortie);
  }

  .entete__rubriques a[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .entete__rubriques a:hover::after {
      transform: scaleX(1);
      transform-origin: 0 50%;
    }
  }

  .entete__marque {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    font-family: var(--serif);
    font-size: 1.0625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      opacity 0.5s var(--sortie),
      visibility 0.5s;
  }

  .entete__marque img {
    width: 2rem;
    height: auto;
  }

  .entete__marque span {
    display: none;
  }

  .entete__actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  .entete__tel {
    display: none;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    white-space: nowrap;
  }

  .entete__reserver {
    display: none;
    min-height: 2.75rem;
    max-width: 16rem;
    padding: 0.55rem 1.25rem;
    overflow: hidden;
    white-space: nowrap;
    transition:
      background-color 0.35s var(--sortie),
      border-color 0.35s var(--sortie),
      opacity 0.5s var(--sortie),
      max-width 0.7s var(--sortie),
      padding 0.7s var(--sortie),
      margin 0.7s var(--sortie),
      visibility 0.5s;
  }

  .entete__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0 0 0 0.5rem;
    border: 0;
    background: none;
    color: inherit;
    font: 500 0.9375rem var(--sans);
    cursor: pointer;
  }

  .entete__menu-traits {
    position: relative;
    width: 1.375rem;
    height: 0.5rem;
  }

  .entete__menu-traits::before,
  .entete__menu-traits::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.45s var(--sortie);
  }

  .entete__menu-traits::before {
    top: 0;
  }

  .entete__menu-traits::after {
    bottom: 0;
  }

  .entete__menu[aria-expanded='true'] .entete__menu-traits::before {
    transform: translateY(3.25px) rotate(45deg);
  }

  .entete__menu[aria-expanded='true'] .entete__menu-traits::after {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Sur mobile, le blason passe à gauche et le menu à droite. */
  @media (max-width: 71.99rem) {
    .entete__barre {
      grid-template-columns: auto 1fr;
    }

    .entete__marque {
      grid-column: 1;
    }

    .entete__actions {
      grid-column: 2;
    }
  }

  @media (min-width: 26rem) {
    .entete__marque span {
      display: inline;
    }
  }

  @media (min-width: 48rem) {
    .entete__reserver {
      display: inline-flex;
    }
  }

  @media (min-width: 72rem) {
    .entete__rubriques {
      display: flex;
    }

    .entete__tel {
      display: inline;
    }

    .entete__menu {
      display: none;
    }
  }

  /* À l'accueil, la marque et le bouton n'apparaissent dans la barre
     qu'une fois le grand blason du haut de page dépassé. */
  :global(html.js.accueil:not(.a-defile)) .entete__marque,
  :global(html.js.accueil:not(.a-defile)) .entete__reserver {
    opacity: 0;
    visibility: hidden;
  }

  :global(html.js.accueil:not(.a-defile)) .entete__reserver {
    max-width: 0;
    padding-inline: 0;
    margin-left: -1.5rem;
    border-width: 0;
  }

  /* ---------- Menu plein écran (mobile et tablette) ---------- */

  .menu {
    position: fixed;
    inset: var(--entete) 0 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 6vh, 3.5rem) var(--marge) calc(2rem + env(safe-area-inset-bottom));
    background: var(--blanc);
    overflow-y: auto;
  }

  .menu[hidden] {
    display: none;
  }

  .menu__liens {
    display: grid;
  }

  .menu__liens a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--filet);
    font-family: var(--serif);
    font-size: clamp(1.875rem, 7.5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .menu__liens a[aria-current='page'] {
    color: var(--vert-vif);
  }

  .menu__liens .menu__reserver {
    color: var(--bordeaux);
    border-bottom: 0;
  }

  .menu__reserver :global(svg) {
    width: 0.7em;
    height: 0.7em;
  }

  .menu__pied {
    display: grid;
    gap: 0.25rem;
    margin-top: 2.5rem;
    font-size: 0.9375rem;
    color: var(--encre-2);
  }

  .menu__pied a {
    color: var(--encre);
    font-size: 1.125rem;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) .menu__liens a {
      animation: monter 0.7s var(--sortie) both;
      animation-delay: calc(var(--i, 0) * 55ms);
    }

    .menu__liens a:nth-child(2) {
      --i: 1;
    }
    .menu__liens a:nth-child(3) {
      --i: 2;
    }
    .menu__liens a:nth-child(4) {
      --i: 3;
    }
    .menu__liens a:nth-child(5) {
      --i: 4;
    }
  }

  @keyframes monter {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
</style>
