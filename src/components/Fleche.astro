---
// Flèche de lien : un seul trait, une seule graisse sur tout le site.
interface Props {
  sortante?: boolean;
}
const { sortante = false } = Astro.props;
---

<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
  {sortante ? <path d="M4.5 11.5l7-7M5.5 4.5h6v6" /> : <path d="M2 8h12M9.5 3.5L14 8l-4.5 4.5" />}
</svg>
