---
import { Image } from 'astro:assets';
import blason from '../assets/blason.png';
import Fleche from './Fleche.astro';
import { site, rubriques } from '../data/site';
---

<footer class="pied">
  <div class="conteneur">
    <div class="pied__haut">
      <a class="pied__marque" href="/" aria-label={`${site.nom}, accueil`}>
        <Image src={blason} alt="" width={72} densities={[1, 2, 3]} />
        <span>
          <span class="pied__nom">{site.nom}</span>
          <span class="pied__baseline">{site.baseline}</span>
        </span>
      </a>
    </div>

    <div class="pied__colonnes">
      <div>
        <h2>Nous trouver</h2>
        <address>
          {site.adresse.map((ligne) => <span>{ligne}</span>)}
        </address>
        <p><a href={site.carte.fiche} target="_blank" rel="noopener" data-itineraire>Voir sur la carte</a></p>
      </div>
      <div>
        <h2>Accueil et club-house</h2>
        <p><a class="pied__tel" href={site.telephoneLien}>{site.telephone}</a></p>
        <ul>
          {site.horaires.map((h) => <li>{h}</li>)}
        </ul>
      </div>
      <nav aria-label="Pied de page">
        <h2>Le club</h2>
        <ul>
          {rubriques.map((r) => <li><a href={r.href}>{r.titre}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2>Réserver</h2>
        <ul>
          <li><a href={site.reservation} target="_blank" rel="noopener">Visiteurs&nbsp;: Grip Resa</a></li>
          <li><a href={site.reservationMembres} target="_blank" rel="noopener">Membres&nbsp;: Net Golf</a></li>
        </ul>
      </div>
    </div>

    <div class="pied__bas">
      <p>© {new Date().getFullYear()} Par72, Golf de la Grande Romanie. Photographies&nbsp;: Par72.</p>
      <p><a href="/mentions-legales">Mentions légales</a></p>
    </div>
  </div>
</footer>

<!-- Sur mobile, « Voir sur la carte » propose l'application de guidage. -->
<dialog class="cartes" data-cartes aria-labelledby="cartes-titre">
  <div class="cartes__contenu">
    <h2 id="cartes-titre">Ouvrir l’itinéraire avec</h2>
    <p class="cartes__lieu">{site.nom}, {site.adresse[1]}</p>
    <ul>
      <li><a href={site.carte.googleMaps} target="_blank" rel="noopener">Google Maps <Fleche sortante /></a></li>
      <li><a href={site.carte.waze} target="_blank" rel="noopener">Waze <Fleche sortante /></a></li>
      <li data-plans><a href={site.carte.plans} target="_blank" rel="noopener">Plans <Fleche sortante /></a></li>
    </ul>
    <button type="button" data-fermer>Annuler</button>
  </div>
</dialog>

<script>
  const dialogue = document.querySelector<HTMLDialogElement>('[data-cartes]');
  const tactile = window.matchMedia('(hover: none) and (pointer: coarse)');

  if (dialogue && typeof dialogue.showModal === 'function') {
    // Plans n'existe que sur les appareils Apple (l'iPad se présente comme un Mac tactile).
    const ua = navigator.userAgent;
    const apple = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    const plans = dialogue.querySelector<HTMLElement>('[data-plans]');
    if (plans) plans.hidden = !apple;

    document.querySelectorAll<HTMLAnchorElement>('[data-itineraire]').forEach((lien) => {
      lien.addEventListener('click', (e) => {
        if (!tactile.matches) return; // ordinateur : le lien ouvre Google Maps
        e.preventDefault();
        dialogue.showModal();
      });
    });

    // Se ferme au choix d'une application, sur « Annuler » ou en touchant le fond.
    dialogue.addEventListener('click', (e) => {
      const cible = e.target as HTMLElement;
      if (cible === dialogue || cible.closest('a, [data-fermer]')) dialogue.close();
    });
  }
</script>

<style>
  .cartes {
    width: 100%;
    max-width: 30rem;
    margin: auto auto 0;
    padding: 0;
    border: 0;
    background: var(--blanc);
    color: var(--encre);
  }

  .cartes::backdrop {
    background: rgb(12 46 31 / 0.6);
  }

  .cartes__contenu {
    padding: 1.75rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
  }

  .cartes h2 {
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .cartes__lieu {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--encre-2);
  }

  .cartes ul {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--filet-fort);
  }

  .cartes [hidden] {
    display: none;
  }

  .cartes li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    border-bottom: 1px solid var(--filet);
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
  }

  .cartes li a :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--encre-2);
  }

  .cartes button {
    width: 100%;
    min-height: 3.25rem;
    margin-top: 1.25rem;
    border: 1px solid var(--filet-fort);
    background: none;
    color: inherit;
    font: 500 0.9375rem / 1.2 var(--sans);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cartes[open] {
      animation: cartes-monter 0.5s var(--sortie);
    }

    .cartes[open]::backdrop {
      animation: cartes-voile 0.4s ease-out;
    }
  }

  @keyframes cartes-monter {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes cartes-voile {
    from {
      opacity: 0;
    }
  }

  .pied {
    background: var(--vert-2);
    color: var(--sur-vert);
    padding-top: clamp(4rem, 8vw, 6.5rem);
    padding-bottom: calc(2rem + var(--barre-mobile, 0px));
    font-size: 0.9375rem;
  }

  .pied a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--sortie);
  }

  @media (hover: hover) {
    .pied a:hover {
      background-size: 100% 1px;
    }
  }

  .pied__marque {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    background: none !important;
  }

  .pied__marque img {
    width: 3.5rem;
    height: auto;
  }

  .pied__nom {
    display: block;
    font-family: var(--serif);
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .pied__baseline {
    display: block;
    margin-top: 0.25rem;
    color: var(--sur-vert-2);
  }

  /* Bloc réglé serré, comme le générique au pied d'une affiche. */
  .pied__colonnes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--filet-vert);
  }

  .pied__colonnes > * {
    padding: 1.75rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--filet-vert);
  }

  .pied h2 {
    font: 500 0.8125rem / 1.4 var(--sans);
    letter-spacing: 0.02em;
    color: var(--sur-vert-2);
    margin-bottom: 0.9rem;
  }

  .pied address {
    font-style: normal;
    display: grid;
  }

  .pied ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .pied p + p,
  .pied address + p,
  .pied p + ul {
    margin-top: 0.6rem;
  }

  .pied__tel {
    font-family: var(--serif);
    font-size: 1.625rem;
    line-height: 1.1;
    font-variant-numeric: lining-nums;
    white-space: nowrap;
  }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.75rem;
    font-size: 0.8125rem;
    color: var(--sur-vert-2);
  }

  .pied__bas p + p {
    margin-top: 0;
  }
</style>
